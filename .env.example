# --- KeeperHub ---
# Organization key from app.keeperhub.com -> Settings -> API Keys. Prefix `kh_`.
# NOT the `wfb_` webhook key: different system, different endpoint, will not authenticate.
KEEPERHUB_API_KEY=kh_
KEEPERHUB_API_URL=https://app.keeperhub.com

# --- What MIRSAD watches ---
# Ethereum Sepolia. The only testnet where Safe deploy, Zodiac Roles,
# Safe pending-tx reads and KeeperHub execution all overlap.
MIRSAD_CHAIN_ID=11155111
MIRSAD_SAFE_ADDRESS=
MIRSAD_REGISTRY_ADDRESS=

# --- Intent-drift classifier ---
# Behind a provider interface: DeepSeek is OpenAI-compatible, so switching
# providers is a base-URL + model change, not a code change.
# `none` runs MIRSAD rules-only — a supported mode, not a degraded one:
# deterministic rules reach VETO on their own, the model only adds WARN
# and reasoning.
MIRSAD_CLASSIFIER=deepseek
CLASSIFIER_API_KEY=
CLASSIFIER_BASE_URL=https://api.deepseek.com
CLASSIFIER_MODEL=deepseek-chat

# --- Behaviour ---
MIRSAD_POLL_INTERVAL_SECONDS=20
# Arming the onchain response is an explicit act. Default off.
MIRSAD_ARMED=false
LOG_LEVEL=info
