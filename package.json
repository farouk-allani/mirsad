{
  "name": "mirsad",
  "version": "0.1.0",
  "private": true,
  "description": "MIRSAD — a watchtower agent that guards multisig treasuries against execution-layer compromise, executing onchain through KeeperHub.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "agent": "pnpm --filter @mirsad/agent run dev"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
