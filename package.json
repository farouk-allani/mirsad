{
  "name": "mirsad",
  "version": "0.1.0",
  "private": true,
  "description": "MIRSAD \u00e2\u20ac\u201d a watchtower agent that guards multisig treasuries against execution-layer compromise, executing onchain through KeeperHub.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "agent": "pnpm --filter @mirsad/agent run dev",
    "mirsad": "node v2/packages/agent/dist/cli.js",
    "doctor": "node apps/agent/dist/main.js doctor",
    "watch": "node apps/agent/dist/main.js watch",
    "audit": "node apps/agent/dist/main.js audit",
    "publish:marketplace": "node apps/agent/dist/main.js publish",
    "v2:build": "pnpm -r --filter \"./v2/packages/**\" run build",
    "v2:test": "pnpm -r --filter \"./v2/packages/**\" run test",
    "v2:typecheck": "pnpm -r --filter \"./v2/packages/**\" run typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dotenv": "^16.6.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
